# Copy this file to .env and fill it in.   cp .env.example .env
# .env is ignored by git. Never commit it, never paste the token in chat or tickets.

# ---------------------------------------------------------------- required
# Base URL of your Jira Data Center / Server, no trailing slash.
JIRA_BASE_URL=https://jira.example.com
# Personal Access Token (Jira: Profile > Personal Access Tokens > Create token).
# Read access to the project and the board is enough. The script never writes to Jira.
JIRA_PAT=

# ------------------------------------------------------- what to report on
# Project key whose issues and versions are reported.
JIRA_PROJECT=TC
# Agile board id that owns the sprints (the number in .../RapidBoard.jspa?rapidView=8).
JIRA_BOARD_ID=8
# Only sprints whose name starts with this are reported (e.g. "TeamAC 2026Q4S1").
SPRINT_PREFIX=TeamAC
# Only sprints whose name contains this are reported. Empty = the current quarter (e.g. 2026Q4).
SPRINT_QUARTER=

# ------------------------------------------------- optional, auto-detected
# Field ids are found by name ("Story Points", "Epic Link"). Set them only if your Jira
# has duplicates or custom names:  GET /rest/api/2/field
JIRA_STORY_POINTS_FIELD=
JIRA_EPIC_LINK_FIELD=

# Roadmap items and their epics. Empty = skills/sprint-review-progress/mapping.json
MAPPING_FILE=
# Where reports are written. Empty = ~/sprint-review
REPORT_OUT_DIR=
